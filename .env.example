# Local development only. In production, use `flyctl secrets set`.

REDDIT_USER_AGENT=karen-finder/0.1 (contact: dbordwell@gmail.com)
# Reddit's app-creation flow is broken for new builders, so we use the
# unauthenticated JSON endpoints. CLIENT_ID/SECRET are no longer needed.
YOUTUBE_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CONSUMER_CHAT_ID=
TELEGRAM_OPERATOR_CHAT_ID=
DATABASE_URL=sqlite:///./karen_finder.db
LOG_LEVEL=INFO
TZ=America/New_York

# Litestream → Cloudflare R2 (production only; leave blank locally)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=karen-finder-backup
R2_ENDPOINT=
